          "401": {
            "description": "Sesión ausente o inválida."
          },
          "409": {
            "description": "Conflicto de estado o recurso no disponible."
          }
        },
        "summary": "Rechazar invitación",
        "description": "Solo destinatario de un vínculo PENDING. Una invitación no aplicable produce 409."
      }
    },
    "/api/v1/communities/contacts/{id}/accept": {
      "put": {
        "tags": [
          "Contactos de confianza"
        ],
        "operationId": "put_api_v1_communities_contacts_id_accept",
