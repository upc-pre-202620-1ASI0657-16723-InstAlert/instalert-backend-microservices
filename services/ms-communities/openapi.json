            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "11111111-1111-4111-8111-111111111111"
          }
        ],
        "responses": {
          "204": {
            "description": "Operación completada sin cuerpo de respuesta."
          },
          "401": {
            "description": "Sesión ausente o inválida."
          },
          "403": {
            "description": "Cuenta autenticada sin permiso para esta operación."
          },
          "404": {
            "description": "Recurso no encontrado o no accesible mediante esta operación."
          },
          "409": {
            "description": "Conflicto de estado o recurso no disponible."
          }
        },
        "summary": "Aceptar invitación",
        "description": "Solo destinatario. Vínculo PENDING o ya ACCEPTED. Registra consentimiento; no permite reactivar vínculos revocados/rechazados."
      }
    },
    "/api/v1/communities": {
      "get": {
        "tags": [
          "Comunidades"
        ],
        "operationId": "get_api_v1_communities",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 50
            },
            "example": 5
          }
        ],
        "responses": {
          "200": {
            "description": "Consulta u operación completada.",
            "content": {
              "application/json": {
                "example": [
                  {
                    "id": 1,
                    "name": "Comunidad Sprint 3",
                    "description": "Grupo de prueba",
                    "isPrivate": false,
                    "ownerId": 1,
                    "member": true
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Datos o parámetros inválidos."
          },
          "401": {
            "description": "Sesión ausente o inválida."
          }
        },
        "summary": "Listar comunidades visibles",
        "description": "Cuenta autenticada. Públicas y privadas propias o con membresía. page: 0–10000; size: 1–100. Devuelve una lista."
      },
      "post": {
        "tags": [
          "Comunidades"
        ],
        "operationId": "post_api_v1_communities",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Create"
              },
              "example": {
                "name": "Comunidad Sprint 3",
                "description": "Grupo de prueba",
                "isPrivate": false
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Recurso creado.",
            "content": {
              "application/json": {
                "example": {
                  "id": 1,
                  "name": "Comunidad Sprint 3",
                  "description": "Grupo de prueba",
                  "isPrivate": false,
                  "ownerId": 1,
                  "member": true
                }
              }
            }
          },
          "400": {
            "description": "Datos o parámetros inválidos."
          },
          "401": {
            "description": "Sesión ausente o inválida."
          },
          "403": {
            "description": "Cuenta autenticada sin permiso para esta operación."
          }
        },
        "summary": "Crear comunidad",
        "description": "Cuenta autenticada. El servidor asigna el propietario y su membresía. ownerId heredado solo se acepta si coincide con la sesión."
      }
    },
