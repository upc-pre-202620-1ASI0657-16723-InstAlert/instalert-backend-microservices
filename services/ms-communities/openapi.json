{
  "openapi": "3.1.0",
  "info": {
    "title": "InstAlert Communities — Sprint 3",
    "version": "1.0.0-local",
    "description": "Contrato OpenAPI 3.1.0 del microservicio independiente. Operaciones verificadas localmente mediante Postman. JWT emitido por Account. Los ejemplos son ilustrativos: sustituir los identificadores por los obtenidos en la ejecución. No representa despliegue cloud."
  },
  "servers": [
    {
      "url": "http://localhost:8085",
      "description": "Local Docker Gateway"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/communities/{id}/support-requests/{requestId}/resolve": {
      "put": {
        "tags": [
          "Membresías y apoyo"
        ],
        "operationId": "put_api_v1_communities_id_support_requests_requestId_resolve",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "example": 1
          },
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "11111111-1111-4111-8111-111111111111"
          }
        ],
        "responses": {
          "204": {
            "description": "Operación completada sin cuerpo de respuesta."
          },
          "400": {
            "description": "Datos o parámetros inválidos."
          },
          "401": {
            "description": "Sesión ausente o inválida."
          },
          "403": {
            "description": "Cuenta autenticada sin permiso para esta operación."
          },
          "404": {
            "description": "Recurso no encontrado o no accesible mediante esta operación."
          }
        },
        "summary": "Resolver solicitud de apoyo",
        "description": "Requiere pertenencia o propiedad. Puede resolver su solicitante, el propietario de la comunidad o un administrador con acceso."
      }
    },
    "/api/v1/communities/notifications/{id}/read": {
      "put": {
        "tags": [
          "Avisos y preferencias"
        ],
        "operationId": "put_api_v1_communities_notifications_id_read",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "11111111-1111-4111-8111-111111111111"
          }
        ],
        "responses": {
          "204": {
            "description": "Operación completada sin cuerpo de respuesta."
          },
          "401": {
            "description": "Sesión ausente o inválida."
          },
          "404": {
            "description": "Recurso no encontrado o no accesible mediante esta operación."
          }
        },
        "summary": "Marcar aviso como leído",
        "description": "Solo destinatario. Aviso ajeno o inexistente: 404. Conserva la primera fecha de lectura."
      }
    },
    "/api/v1/communities/notification-preferences": {
      "get": {
        "tags": [
          "Avisos y preferencias"
        ],
        "operationId": "get_api_v1_communities_notification_preferences",
        "responses": {
          "200": {
            "description": "Consulta u operación completada.",
            "content": {
              "application/json": {
                "example": {
                  "enabled": true
                }
              }
            }
          },
          "401": {
            "description": "Sesión ausente o inválida."
          }
        },
        "summary": "Consultar preferencia de avisos",
        "description": "Cuenta autenticada. Preferencia propia; por defecto enabled=true."
      },
      "put": {
        "tags": [
          "Avisos y preferencias"
        ],
        "operationId": "put_api_v1_communities_notification_preferences",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Preference"
              },
              "example": {
                "enabled": true
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Operación completada sin cuerpo de respuesta."
          },
          "400": {
            "description": "Datos o parámetros inválidos."
          },
          "401": {
            "description": "Sesión ausente o inválida."
          }
        },
        "summary": "Actualizar preferencia de avisos",
        "description": "Cuenta autenticada. enabled boolean obligatorio. Opt-out bloquea nuevas creaciones, no las cancelaciones de alertas ya recibidas."
      }
    },
